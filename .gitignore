# ROS2 / colcon build artifacts
build/
install/
log/
# iCloud-Drive workaround: real dirs live under .nosync siblings,
# install/build/log are symlinks to them so iCloud will not sync
# build artifacts (which otherwise produce "X 2" duplicate files
# that break colcon + Docker bind mounts).
build.nosync/
install.nosync/
log.nosync/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# macOS
.DS_Store

# Editors
.vscode/
.idea/
*.swp

# rosbag recordings (large)
media/bags/

# Metrics output
*.csv.tmp

# Sim debug logs (tee'd output from sim/nav2 launch chains)
sim.log
nav2.log

# Phase 4 benchmark outputs:
#   results/metrics.csv  -> COMMITTED (docs/results.md deliverable)
#   media/plots/*.png    -> COMMITTED (referenced by README/results.md)
#   media/bags/          -> ignored above (large rosbags)
# Transient per-run logs and the sync flag are not committed:
results/logs/
results/.run_complete

# Claude Code local IDE settings
.claude/

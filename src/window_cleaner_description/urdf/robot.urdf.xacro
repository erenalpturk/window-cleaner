<?xml version="1.0"?>
<robot name="window_cleaner" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="base_length" value="0.30"/>
  <xacro:property name="base_width"  value="0.30"/>
  <xacro:property name="base_height" value="0.05"/>
  <xacro:property name="base_mass"   value="1.5"/>

  <xacro:property name="wheel_radius"    value="0.04"/>
  <xacro:property name="wheel_thickness" value="0.02"/>
  <xacro:property name="wheel_mass"      value="0.05"/>
  <xacro:property name="wheel_x_offset"  value="0.10"/>
  <xacro:property name="wheel_y_offset"  value="0.16"/>

  <xacro:property name="vacuum_radius" value="0.12"/>
  <xacro:property name="vacuum_height" value="0.02"/>
  <xacro:property name="vacuum_mass"   value="0.10"/>

  <xacro:property name="camera_size" value="0.04"/>
  <xacro:property name="camera_mass" value="0.05"/>

  <xacro:property name="lidar_radius" value="0.025"/>
  <xacro:property name="lidar_height" value="0.03"/>
  <xacro:property name="lidar_mass"   value="0.05"/>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12.0}" iyz="0"
               izz="${m*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia_y" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="${m*(3.0*r*r+h*h)/12.0}" ixy="0" ixz="0"
               iyy="${m*r*r/2.0}" iyz="0"
               izz="${m*(3.0*r*r+h*h)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia_z" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="${m*(3.0*r*r+h*h)/12.0}" ixy="0" ixz="0"
               iyy="${m*(3.0*r*r+h*h)/12.0}" iyz="0"
               izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

  <material name="chassis_grey"><color rgba="0.45 0.45 0.55 1.0"/></material>
  <material name="pad_black">   <color rgba="0.10 0.10 0.10 1.0"/></material>
  <material name="wheel_black"> <color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="camera_red">  <color rgba="0.85 0.10 0.10 1.0"/></material>
  <material name="lidar_blue">  <color rgba="0.10 0.30 0.85 1.0"/></material>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${base_height/2 + wheel_radius}"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
  </link>

  <link name="vacuum_pad_link">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><cylinder radius="${vacuum_radius}" length="${vacuum_height}"/></geometry>
      <material name="pad_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><cylinder radius="${vacuum_radius}" length="${vacuum_height}"/></geometry>
    </collision>
    <xacro:cylinder_inertia_z m="${vacuum_mass}" r="${vacuum_radius}" h="${vacuum_height}"/>
  </link>

  <joint name="vacuum_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="vacuum_pad_link"/>
    <origin xyz="0 0 ${-base_height/2 - vacuum_height/2}"/>
  </joint>

  <xacro:macro name="wheel" params="prefix x_sign y_sign">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_thickness}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_thickness}"/></geometry>
      </collision>
      <xacro:cylinder_inertia_y m="${wheel_mass}" r="${wheel_radius}" h="${wheel_thickness}"/>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_wheel_link"/>
      <origin xyz="${x_sign*wheel_x_offset} ${y_sign*wheel_y_offset} ${-base_height/2}"/>
      <axis xyz="0 1 0"/>
      <limit effort="10.0" velocity="10.0"/>
      <dynamics damping="0.05" friction="0.10"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="front_left"  x_sign="1"  y_sign="1"/>
  <xacro:wheel prefix="front_right" x_sign="1"  y_sign="-1"/>
  <xacro:wheel prefix="rear_left"   x_sign="-1" y_sign="1"/>
  <xacro:wheel prefix="rear_right"  x_sign="-1" y_sign="-1"/>

  <link name="camera_link">
    <!-- No <visual> and no <collision> on purpose.
         The frame walls are only 0.10 m tall (world z in [0.005, 0.105]),
         but this robot is taller: with spawn z=0.05 the lidar scan plane
         sits at world z=0.155, ABOVE the walls, so the 360 gpu_lidar never
         sees the frame at all. gpu_lidar is GPU-render based -> it detects
         VISUAL geometry, not collision. The camera housing's visual box
         spans world z in [0.14, 0.18] and x in [0.11, 0.15] (forward of
         base centre), i.e. exactly across the lidar plane ~0.11 m dead
         ahead. The lidar therefore self-detected the camera box as a
         permanent obstacle and RPP aborted every mission with
         "collision ahead -> patience exceeded" (removing only <collision>
         did nothing because gpu_lidar ignores collision). Dropping the
         visual makes the camera invisible to the lidar render pass; the
         rgb_camera sensor (attached via <gazebo reference="camera_link">)
         and the link inertia are unaffected. Real frame avoidance comes
         from the static map in the global costmap, not this lidar. -->
    <xacro:box_inertia m="${camera_mass}" x="${camera_size}" y="${camera_size}" z="${camera_size}"/>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="${base_length/2 - camera_size/2} 0 ${base_height/2 + camera_size/2}"/>
  </joint>

  <link name="camera_optical"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_optical"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
      <material name="lidar_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
    </collision>
    <xacro:cylinder_inertia_z m="${lidar_mass}" r="${lidar_radius}" h="${lidar_height}"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <origin xyz="0 0 ${base_height/2 + lidar_height/2}"/>
  </joint>

  <xacro:include filename="$(find window_cleaner_description)/urdf/sensors.xacro"/>

</robot>

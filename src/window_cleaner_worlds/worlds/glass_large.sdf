<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="glass_large">

    <!-- ============================================================
         Phase 4 world variant: 5 m x 3 m large glass, MANY stains.
         Geometry is intentionally IDENTICAL to glass_basic (same
         surface, frame, spawn, Nav2 map and tuning) — only the dirt
         count changes, so this stresses the perception / cleaning
         pipeline without requiring forbidden Nav2 re-tuning. Created
         as a roadmap 4.4 artifact; NOT part of the 6-run benchmark
         matrix (user decision 2026-05-16).
         ============================================================ -->
    <gravity>0 0 0</gravity>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.5 0.5 0.6 1</ambient>
      <background>0.85 0.90 0.95 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.3 -1.0</direction>
    </light>

    <!-- ============================================================
         Glass surface (5m x 3m, slightly translucent blue) — same as
         glass_basic.
         ============================================================ -->
    <model name="glass_surface">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="surface_link">
        <visual name="surface_visual">
          <geometry>
            <box><size>5.0 3.0 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.15 0.35 0.55 0.45</ambient>
            <diffuse>0.25 0.55 0.85 0.45</diffuse>
            <specular>0.6 0.7 0.9 1</specular>
            <emissive>0.05 0.10 0.15 1</emissive>
          </material>
        </visual>
        <collision name="surface_collision">
          <geometry>
            <box><size>5.0 3.0 0.01</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ============================================================
         Window frame (4 thin walls) — identical to glass_basic.
         ============================================================ -->
    <model name="frame_bottom">
      <static>true</static>
      <pose>0 -1.525 0.055 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>5.10 0.05 0.10</size></box></geometry>
          <material>
            <ambient>0.35 0.25 0.18 1</ambient>
            <diffuse>0.55 0.40 0.25 1</diffuse>
          </material>
        </visual>
        <collision name="c">
          <geometry><box><size>5.10 0.05 0.10</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="frame_top">
      <static>true</static>
      <pose>0 1.525 0.055 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>5.10 0.05 0.10</size></box></geometry>
          <material>
            <ambient>0.35 0.25 0.18 1</ambient>
            <diffuse>0.55 0.40 0.25 1</diffuse>
          </material>
        </visual>
        <collision name="c">
          <geometry><box><size>5.10 0.05 0.10</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="frame_left">
      <static>true</static>
      <pose>-2.525 0 0.055 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.05 3.00 0.10</size></box></geometry>
          <material>
            <ambient>0.35 0.25 0.18 1</ambient>
            <diffuse>0.55 0.40 0.25 1</diffuse>
          </material>
        </visual>
        <collision name="c">
          <geometry><box><size>0.05 3.00 0.10</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="frame_right">
      <static>true</static>
      <pose>2.525 0 0.055 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.05 3.00 0.10</size></box></geometry>
          <material>
            <ambient>0.35 0.25 0.18 1</ambient>
            <diffuse>0.55 0.40 0.25 1</diffuse>
          </material>
        </visual>
        <collision name="c">
          <geometry><box><size>0.05 3.00 0.10</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ============================================================
         Dirty regions — MANY (11) discs spread across the surface.
         All visual-only, z=0.011, clear of the frame walls.
         ============================================================ -->
    <model name="dirt_01">
      <static>true</static><pose>-1.5 0.8 0.011 0 0 0</pose>
      <link name="link"><visual name="v">
        <geometry><cylinder><radius>0.20</radius><length>0.005</length></cylinder></geometry>
        <material><ambient>0.30 0.18 0.10 1</ambient><diffuse>0.45 0.28 0.15 1</diffuse></material>
      </visual></link>
    </model>

    <model name="dirt_02">
      <static>true</static><pose>0.6 -0.7 0.011 0 0 0</pose>
      <link name="link"><visual name="v">
        <geometry><cylinder><radius>0.25</radius><length>0.005</length></cylinder></geometry>
        <material><ambient>0.30 0.18 0.10 1</ambient><diffuse>0.45 0.28 0.15 1</diffuse></material>
      </visual></link>
    </model>

    <model name="dirt_03">
      <static>true</static><pose>1.8 0.5 0.011 0 0 0</pose>
      <link name="link"><visual name="v">
        <geometry><cylinder><radius>0.15</radius><length>0.005</length></cylinder></geometry>
        <material><ambient>0.30 0.18 0.10 1</ambient><diffuse>0.45 0.28 0.15 1</diffuse></material>
      </visual></link>
    </model>

    <model name="dirt_04">
      <static>true</static><pose>-0.5 -0.4 0.011 0 0 0</pose>
      <link name="link"><visual name="v">
        <geometry><cylinder><radius>0.18</radius><length>0.005</length></cylinder></geometry>
        <material><ambient>0.30 0.18 0.10 1</ambient><diffuse>0.45 0.28 0.15 1</diffuse></material>
      </visual></link>
    </model>

    <model name="dirt_05">
      <static>true</static><pose>1.0 1.0 0.011 0 0 0</pose>
      <link name="link"><visual name="v">
        <geometry><cylinder><radius>0.22</radius><length>0.005</length></cylinder></geometry>
        <material><ambient>0.30 0.18 0.10 1</ambient><diffuse>0.45 0.28 0.15 1</diffuse></material>
      </visual></link>
    </model>

    <model name="dirt_06">
      <static>true</static><pose>-2.0 -0.9 0.011 0 0 0</pose>
      <link name="link"><visual name="v">
        <geometry><cylinder><radius>0.17</radius><length>0.005</length></cylinder></geometry>
        <material><ambient>0.30 0.18 0.10 1</ambient><diffuse>0.45 0.28 0.15 1</diffuse></material>
      </visual></link>
    </model>

    <model name="dirt_07">
      <static>true</static><pose>2.0 -1.0 0.011 0 0 0</pose>
      <link name="link"><visual name="v">
        <geometry><cylinder><radius>0.16</radius><length>0.005</length></cylinder></geometry>
        <material><ambient>0.30 0.18 0.10 1</ambient><diffuse>0.45 0.28 0.15 1</diffuse></material>
      </visual></link>
    </model>

    <model name="dirt_08">
      <static>true</static><pose>-1.0 1.1 0.011 0 0 0</pose>
      <link name="link"><visual name="v">
        <geometry><cylinder><radius>0.14</radius><length>0.005</length></cylinder></geometry>
        <material><ambient>0.30 0.18 0.10 1</ambient><diffuse>0.45 0.28 0.15 1</diffuse></material>
      </visual></link>
    </model>

    <model name="dirt_09">
      <static>true</static><pose>0.0 0.0 0.011 0 0 0</pose>
      <link name="link"><visual name="v">
        <geometry><cylinder><radius>0.20</radius><length>0.005</length></cylinder></geometry>
        <material><ambient>0.30 0.18 0.10 1</ambient><diffuse>0.45 0.28 0.15 1</diffuse></material>
      </visual></link>
    </model>

    <model name="dirt_10">
      <static>true</static><pose>2.0 1.1 0.011 0 0 0</pose>
      <link name="link"><visual name="v">
        <geometry><cylinder><radius>0.13</radius><length>0.005</length></cylinder></geometry>
        <material><ambient>0.30 0.18 0.10 1</ambient><diffuse>0.45 0.28 0.15 1</diffuse></material>
      </visual></link>
    </model>

    <model name="dirt_11">
      <static>true</static><pose>-2.0 1.0 0.011 0 0 0</pose>
      <link name="link"><visual name="v">
        <geometry><cylinder><radius>0.15</radius><length>0.005</length></cylinder></geometry>
        <material><ambient>0.30 0.18 0.10 1</ambient><diffuse>0.45 0.28 0.15 1</diffuse></material>
      </visual></link>
    </model>

  </world>
</sdf>

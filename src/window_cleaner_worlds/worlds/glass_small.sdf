<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="glass_small">

    <!-- ============================================================
         Phase 4 world variant: 2 m x 1 m small glass, few stains.
         Same zero-gravity 2D planar abstraction as glass_basic; only
         the surface size, frame walls and dirt count differ. Spawn /
         Nav2 map / map->odom offset are world-relative (see
         window_cleaner_evaluation/config/worlds_manifest.yaml).
         ============================================================ -->
    <gravity>0 0 0</gravity>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.5 0.5 0.6 1</ambient>
      <background>0.85 0.90 0.95 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.3 -1.0</direction>
    </light>

    <!-- ============================================================
         Glass surface (2m x 1m, slightly translucent blue)
         ============================================================ -->
    <model name="glass_surface">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="surface_link">
        <visual name="surface_visual">
          <geometry>
            <box><size>2.0 1.0 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.15 0.35 0.55 0.45</ambient>
            <diffuse>0.25 0.55 0.85 0.45</diffuse>
            <specular>0.6 0.7 0.9 1</specular>
            <emissive>0.05 0.10 0.15 1</emissive>
          </material>
        </visual>
        <collision name="surface_collision">
          <geometry>
            <box><size>2.0 1.0 0.01</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ============================================================
         Window frame (4 thin walls around the perimeter)
         Frame thickness 0.05m, height 0.10m. Wall centre at
         +/-(dim/2 + 0.025); long-wall length = dim + 0.10.
         ============================================================ -->
    <model name="frame_bottom">
      <static>true</static>
      <pose>0 -0.525 0.055 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>2.10 0.05 0.10</size></box></geometry>
          <material>
            <ambient>0.35 0.25 0.18 1</ambient>
            <diffuse>0.55 0.40 0.25 1</diffuse>
          </material>
        </visual>
        <collision name="c">
          <geometry><box><size>2.10 0.05 0.10</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="frame_top">
      <static>true</static>
      <pose>0 0.525 0.055 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>2.10 0.05 0.10</size></box></geometry>
          <material>
            <ambient>0.35 0.25 0.18 1</ambient>
            <diffuse>0.55 0.40 0.25 1</diffuse>
          </material>
        </visual>
        <collision name="c">
          <geometry><box><size>2.10 0.05 0.10</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="frame_left">
      <static>true</static>
      <pose>-1.025 0 0.055 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.05 1.00 0.10</size></box></geometry>
          <material>
            <ambient>0.35 0.25 0.18 1</ambient>
            <diffuse>0.55 0.40 0.25 1</diffuse>
          </material>
        </visual>
        <collision name="c">
          <geometry><box><size>0.05 1.00 0.10</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="frame_right">
      <static>true</static>
      <pose>1.025 0 0.055 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.05 1.00 0.10</size></box></geometry>
          <material>
            <ambient>0.35 0.25 0.18 1</ambient>
            <diffuse>0.55 0.40 0.25 1</diffuse>
          </material>
        </visual>
        <collision name="c">
          <geometry><box><size>0.05 1.00 0.10</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ============================================================
         Dirty regions (visual-only brown discs lying on the glass).
         Few stains for the small world; well inside +/-1.0 / +/-0.5.
         ============================================================ -->
    <model name="dirt_01">
      <static>true</static>
      <pose>-0.50 0.20 0.011 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><cylinder><radius>0.13</radius><length>0.005</length></cylinder></geometry>
          <material>
            <ambient>0.30 0.18 0.10 1</ambient>
            <diffuse>0.45 0.28 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="dirt_02">
      <static>true</static>
      <pose>0.45 -0.18 0.011 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><cylinder><radius>0.10</radius><length>0.005</length></cylinder></geometry>
          <material>
            <ambient>0.30 0.18 0.10 1</ambient>
            <diffuse>0.45 0.28 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
